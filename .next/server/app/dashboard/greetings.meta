{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/greetings/layout,_N_T_/dashboard/greetings/page,_N_T_/dashboard/greetings"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/greetings/__PAGE__",
    "/dashboard/greetings",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}