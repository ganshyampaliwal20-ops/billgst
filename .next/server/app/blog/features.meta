{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/features/layout,_N_T_/blog/features/page,_N_T_/blog/features"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/blog/features/__PAGE__",
    "/blog/features",
    "/blog",
    "/_index",
    "/_head"
  ]
}